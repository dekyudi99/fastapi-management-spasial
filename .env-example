# GeoServer Internal URL (untuk komunikasi backend ke GeoServer di Docker)
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=rahasia

# URL untuk client browser (HP, laptop, web frontend):
# - Di lokal: http://localhost:8080/geoserver
# - Di Server/VPS/Proxmox: https://<domain-geoserver>/geoserver
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# Microservice GeoServer terpisah
GEOSERVER_MICROSERVICE_URL=http://localhost:8001

# Central Database: API Auth & Metadata (voxagis_user)
DB_HOST=db-central-postgres
DB_PORT=5432
DB_NAME=voxagis_user
DB_USER=voxagis_app
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://voxagis_app:your_password_here@db-central-postgres:5432/voxagis_user

# Autentikasi JWT Legacy
SECRET_KEY="SUPER_SECRET_KODE_RAHASIA_ANDA_12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
LEGACY_AUTH_ENABLED=true

# Keycloak SSO (Realm: astra, Client: voxagis)
KEYCLOAK_ISSUER=http://localhost:8081/realms/astra
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/astra/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=voxagis
KEYCLOAK_REQUIRED_ROLE=app-voxagis

SECRET_ALPHABET="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

# CORS Allowed Origins (pisahkan dengan koma untuk domain frontend)
# Contoh: http://localhost:5173,http://localhost:5174,https://astragis.ikya.my.id
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://astragis.ikya.my.id,https://flowgis.ikya.my.id

# Vector Simplification Tolerance (nilai tetap diatur di environment, user tidak bisa mengubah)
SIMPLIFY_TOLERANCE=0.00005