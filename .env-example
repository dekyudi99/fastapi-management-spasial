# GeoServer Internal URL (untuk komunikasi backend ke GeoServer di Docker)
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=rahasia

# URL untuk client browser (HP, laptop, web frontend):
# - Di lokal: http://localhost:8080/geoserver
# - Di Server/VPS/Proxmox: https://<domain-geoserver>/geoserver
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# Database PostgreSQL / PostGIS
DB_HOST=db
DB_PORT=5432
DB_NAME=spasial_db
DB_USER=postgres
DB_PASSWORD=rahasia

# Autentikasi JWT
SECRET_KEY="SUPER_SECRET_KODE_RAHASIA_ANDA_12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

SECRET_ALPHABET="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

# CORS Allowed Origins (pisahkan dengan koma untuk domain frontend)
# Contoh: http://localhost:5173,http://localhost:5174,https://astragis.ikya.my.id
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://astragis.ikya.my.id,https://flowgis.ikya.my.id